{
  "name": "EmailAgent",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bullseye",
  "postCreateCommand": "bash scripts/codespaces-startup.sh",
  "postStartCommand": "test -f .codespaces/agent-env || bash scripts/codespaces-startup.sh",
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": ".venv/bin/python"
      }
    }
  }
}
